{
  "expo": {
    "name": "neuroxis-mobile",
    "slug": "neuroxis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090D16"
      },
      "edgeToEdge": true,
      "statusBar": {
        "barStyle": "light-content",
        "backgroundColor": "#090D16"
      },
      "navigationBar": {
        "barStyle": "light-content",
        "backgroundColor": "#090D16"
      }
    },
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
